---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Host · Las Gordibuenas">
  <div class="grid" style="gap: 1rem;">
    <div class="row between">
      <h1>Panel host</h1>
      <nav>
        <a href="/">Inicio</a>
        <a class="active" href="/host">Host</a>
        <a href="/mesero">Mesero</a>
        <a href="/cocina">Cocina</a>
      </nav>
    </div>

    <section class="card">
      <h2>Guisados del día</h2>
      <p class="muted">Separados por coma. Ejemplo: Chicharrón, Deshebrada, Frijoles.</p>
      <textarea id="guisados" rows="3"></textarea>
      <div class="row">
        <button id="guardar" class="btn">Guardar</button>
        <span id="mensaje" class="muted"></span>
      </div>
    </section>

    <section class="grid cols-3" id="resumen"></section>
  </div>

  <script>
    // @ts-nocheck
    const guisadosEl = document.getElementById('guisados');
    const messageEl = document.getElementById('mensaje');
    const summaryEl = document.getElementById('resumen');

    const fetchConfig = async () => {
      const res = await fetch('/api/config');
      const data = await res.json();
      guisadosEl.value = data.guisadosDelDia.join(', ');
    };

    const fetchSummary = async () => {
      const res = await fetch('/api/summary');
      const data = await res.json();
      summaryEl.innerHTML = `
        <article class="card"><h2>Pedidos hoy</h2><p>${data.counts.total}</p></article>
        <article class="card"><h2>Terminados</h2><p>${data.counts.completed}</p></article>
        <article class="card"><h2>Cancelados</h2><p>${data.counts.cancelled}</p></article>
        <article class="card"><h2>Activos</h2><p>${data.counts.active}</p></article>
        <article class="card"><h2>Venta cerrada</h2><p>$${data.revenue.sold}</p></article>
        <article class="card"><h2>Venta en proceso</h2><p>$${data.revenue.inProgress}</p></article>
      `;
    };

    document.getElementById('guardar')?.addEventListener('click', async () => {
      const guisados = guisadosEl.value
        .split(',')
        .map((item) => item.trim())
        .filter(Boolean);

      const response = await fetch('/api/config', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ guisadosDelDia: guisados }),
      });

      messageEl.textContent = response.ok ? 'Guardado.' : 'Error al guardar.';
      fetchSummary();
    });

    fetchConfig();
    fetchSummary();
    setInterval(fetchSummary, 5000);
  </script>
</BaseLayout>
