---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Cocina KDS · Las Gordibuenas" fullWidth={true}>
  <div class="kds-container">
    <!-- Header KDS Estilo Suizo para Tablet (Sin emojis) -->
    <header class="kds-header">
      <div class="row" style="gap: 1.25rem;">
        <div>
          <div class="swiss-label" style="color: #a1a1aa;">SISTEMA KDS · TERMINAL COCINA</div>
          <h1 style="font-size: 1.6rem; color: #ffffff; margin-top: 2px;">LAS GORDIBUENAS</h1>
        </div>
        <div id="liveClock" style="font-size: 1.5rem; font-weight: 900; color: #f43f5e; font-variant-numeric: tabular-nums; border-left: 2px solid #3f3f46; padding-left: 1.25rem;">
          --:--
        </div>
      </div>

      <div class="row" style="gap: 0.5rem; flex-wrap: wrap;">
        <!-- Walkie Talkie -->
        <button id="wtButton" class="walkie-btn" style="background: #18181b; color: #fff; border-color: #3f3f46;" title="Hablar con Meseros">
          <span id="wtLabel">WALKIE A MESEROS</span>
          <span id="wtTimer" style="display:none; font-variant-numeric: tabular-nums; margin-left: 4px;">0:00</span>
        </button>

        <!-- Toggle Sonido -->
        <button id="soundToggleBtn" class="btn secondary" style="min-height: 38px; padding: 0.35rem 0.75rem; font-size: 0.75rem; background: #27272a; color: #fff; border-color: #3f3f46;">
          SONIDO ON
        </button>

        <!-- Pantalla Completa -->
        <button id="fullscreenBtn" class="btn secondary" style="min-height: 38px; padding: 0.35rem 0.75rem; font-size: 0.75rem; background: #27272a; color: #fff; border-color: #3f3f46;">
          PANTALLA COMPLETA
        </button>

        <nav>
          <a href="/mesero" style="color: #cbd5e1; border-color: #52525b; background: transparent; font-size: 0.75rem; min-height: 38px;">MESERO</a>
          <a href="/host" style="color: #cbd5e1; border-color: #52525b; background: transparent; font-size: 0.75rem; min-height: 38px;">HOST</a>
        </nav>
      </div>
    </header>

    <!-- Banner flotante de audio entrante del Mesero -->
    <div id="incomingAudioBanner" class="audio-notification-banner" style="display: none; background: #18181b; border: 1px solid #3f3f46;">
      <span id="incomingAudioText">MENSAJE DE VOZ DE MESERO</span>
      <div class="row" style="gap: 0.4rem;">
        <button id="replayAudioBtn" class="btn secondary" style="min-height: 26px; padding: 0.15rem 0.45rem; font-size: 0.7rem;">REPETIR</button>
        <button id="dismissAudioBtn" style="background:transparent; border:none; color:#fff; cursor:pointer; font-weight:900;">X</button>
      </div>
    </div>

    <!-- MONITOR DE PLANCHA / COMAL (TOTALIZADOR ACUMULADO) -->
    <section class="kds-summary-bar">
      <div class="kds-summary-title">
        TOTAL EN COMAL (SUMA ACTIVA):
      </div>
      <div class="kds-summary-chips" id="comalSummaryContainer">
        <span class="muted" style="color: #71717a;">Sin ordenes activas en plancha.</span>
      </div>
    </section>

    <!-- ESCENARIO PRINCIPAL KDS: STACK OPTICO A LA IZQUIERDA Y GRID DE TARJETAS -->
    <main class="kds-workspace">
      <!-- Efecto óptico stackeado hacia la izquierda para comandas en espera -->
      <aside id="kdsOpticalStack" class="kds-optical-stack" style="display: none;">
        <div class="kds-stack-layers">
          <div class="kds-stack-card layer-3"></div>
          <div class="kds-stack-card layer-2"></div>
          <div class="kds-stack-card layer-1">
            <span class="kds-stack-folio" id="kdsNextFolio">#--</span>
            <span class="kds-stack-count" id="kdsOverflowCount">+0</span>
            <span class="kds-stack-label">EN ESPERA</span>
          </div>
        </div>
      </aside>

      <!-- Tarjetas Visibles (2 o 3 simultáneas) -->
      <section id="kdsCardsStage" class="kds-cards-stage">
        <div class="empty" style="grid-column: 1 / -1; color: #18181b; border: 2px dashed #000; padding: 3rem 1rem; text-align: center; background: #fff;">
          <p style="font-size: 1.25rem; font-weight: 900; letter-spacing: -0.02em;">COMAL Y COCINA AL DÍA</p>
          <p style="margin-top: 0.5rem; font-size: 0.85rem; font-weight: 800; color: #71717a;">ESPERANDO NUEVAS COMANDAS DE LOS MESEROS</p>
        </div>
      </section>
    </main>
  </div>

  <script>
    // @ts-nocheck

    const state = {
      orders: [],
      knownFolios: new Set(),
      soundEnabled: true,
      lastAudioTimestamp: Date.now() - 60000,
      lastPlayedAudioData: null,
      playedAudioIds: new Set(),
      isRecordingWT: false,
    };

    // RELOJ DIGITAL EN VIVO
    const updateClock = () => {
      const clockEl = document.getElementById('liveClock');
      if (clockEl) {
        clockEl.textContent = new Date().toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
      }
    };
    setInterval(updateClock, 1000);
    updateClock();

    // SINTETIZADOR DE CAMPANA DE RESTAURANTE (WEB AUDIO API NATIVO)
    const playOrderDing = () => {
      if (!state.soundEnabled) return;
      try {
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        if (!AudioContext) return;
        const ctx = new AudioContext();

        const osc = ctx.createOscillator();
        const gain = ctx.createGain();

        osc.type = 'sine';
        osc.frequency.setValueAtTime(880, ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(1760, ctx.currentTime + 0.1);
        osc.frequency.exponentialRampToValueAtTime(1320, ctx.currentTime + 0.4);

        gain.gain.setValueAtTime(0.3, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 1.2);

        osc.connect(gain);
        gain.connect(ctx.destination);

        osc.start();
        osc.stop(ctx.currentTime + 1.2);
      } catch (e) {
        console.log(e);
      }
    };

    // TIEMPO TRANSCURRIDO CON SEMAFORO
    const getElapsedInfo = (createdAtIso) => {
      const created = new Date(createdAtIso).getTime();
      const now = Date.now();
      const diffMinutes = Math.floor((now - created) / 60000);

      let colorClass = 'green';
      if (diffMinutes >= 10) {
        colorClass = 'red';
      } else if (diffMinutes >= 5) {
        colorClass = 'yellow';
      }

      return {
        minutes: diffMinutes,
        colorClass,
        label: `${diffMinutes}M`,
        isUrgent: diffMinutes >= 12,
      };
    };

    // MONITOR DE COMAL (SUMATORIA DE GUISADOS EN TIEMPO REAL)
    const updateComalSummary = (activeOrders) => {
      const container = document.getElementById('comalSummaryContainer');
      if (!container) return;

      const totals = {};
      let totalGorditas = 0;

      activeOrders.forEach((order) => {
        order.items.forEach((item) => {
          if (item.kind === 'guisado') {
            totals[item.name] = (totals[item.name] || 0) + item.quantity;
            totalGorditas += item.quantity;
          }
        });
      });

      if (totalGorditas === 0) {
        container.innerHTML = '<span class="muted" style="color: #71717a; font-size: 0.85rem; font-weight: 700;">COMAL LIBRE - SIN GORDITAS ACTIVAS</span>';
        return;
      }

      const chipsHtml = Object.entries(totals)
        .sort((a, b) => b[1] - a[1])
        .map(([name, qty]) => `
          <div class="kds-comal-chip">
            <span class="chip-qty">${qty}</span>
            <span>${name}</span>
          </div>
        `)
        .join('');

      container.innerHTML = `
        <div style="display:flex; align-items:center; gap:0.5rem; margin-right: 0.5rem;">
          <strong style="color:var(--swiss-black); font-size:0.95rem; font-weight:900;">TOTAL: ${totalGorditas}</strong>
        </div>
        ${chipsHtml}
      `;
    };

    // RENDERIZADO DE TICKETS KDS ESTILO SUIZO (TABLET HORIZONTAL: 2-3 TARJETAS VISIBLES + STACK A LA IZQUIERDA)
    const renderKdsQueue = (queue) => {
      const stageEl = document.getElementById('kdsCardsStage');
      const opticalStackEl = document.getElementById('kdsOpticalStack');
      const overflowCountEl = document.getElementById('kdsOverflowCount');
      const nextFolioEl = document.getElementById('kdsNextFolio');
      if (!stageEl) return;

      if (!queue.length) {
        if (opticalStackEl) opticalStackEl.style.display = 'none';
        stageEl.style.setProperty('--visible-cols', '1');
        stageEl.innerHTML = `
          <div class="empty" style="grid-column: 1 / -1; color: #18181b; border: 2px dashed #000; padding: 3rem 1rem; text-align: center; background: #fff;">
            <p style="font-size: 1.25rem; font-weight: 900; letter-spacing: -0.02em;">COMAL Y COCINA AL DÍA</p>
            <p style="margin-top: 0.5rem; font-size: 0.85rem; font-weight: 800; color: #71717a;">ESPERANDO NUEVAS COMANDAS DE LOS MESEROS</p>
          </div>
        `;
        return;
      }

      // Máximo 2 o 3 tarjetas simultáneas para optimizar el tamaño en tablet horizontal
      const visibleMax = window.innerWidth >= 1000 ? 3 : 2;
      const visibleOrders = queue.slice(0, visibleMax);
      const overflowCount = queue.length - visibleOrders.length;

      // Efecto óptico stackeado hacia la izquierda
      if (opticalStackEl) {
        if (overflowCount > 0) {
          opticalStackEl.style.display = 'flex';
          if (overflowCountEl) overflowCountEl.textContent = `+${overflowCount}`;
          if (nextFolioEl && queue[visibleMax]) nextFolioEl.textContent = `#${queue[visibleMax].folio}`;
        } else {
          opticalStackEl.style.display = 'none';
        }
      }

      // Definir columnas activas en el grid
      stageEl.style.setProperty('--visible-cols', visibleOrders.length);

      // Preservar la posición de scroll de los pedidos para que no se regresen al inicio al actualizarse
      const scrollPositions = new Map();
      stageEl.querySelectorAll('.kds-card').forEach((card) => {
        const id = card.dataset.orderId;
        const body = card.querySelector('.kds-card-body');
        if (id && body) {
          scrollPositions.set(id, body.scrollTop);
        }
      });

      stageEl.innerHTML = visibleOrders
        .map((order) => {
          const elapsed = getElapsedInfo(order.createdAt);
          const clientIdentifier = order.customerName || 'CLIENTE';

          const additionalBadge = order.round && order.round > 1
            ? `<span style="background:var(--swiss-black); color:#fff; padding:2px 6px; border-radius:3px; margin-left:4px; font-weight:900; font-size:0.7rem;">TANDA #${order.round}</span>`
            : '';

          let destinationHtml = '';
          if (order.orderType === 'aqui') {
            destinationHtml = `
              <div class="kds-card-meta">
                ${clientIdentifier} [COMER AQUÍ] ${additionalBadge}
              </div>
            `;
          } else if (order.orderType === 'llevar') {
            destinationHtml = `
              <div class="kds-card-meta" style="color:#0284c7;">
                PARA LLEVAR: ${clientIdentifier} ${additionalBadge}
              </div>
            `;
          } else if (order.orderType === 'domicilio') {
            destinationHtml = `
              <div class="kds-card-meta" style="color:#dc2626;">
                DOMICILIO: ${order.address || 'SIN DIRECCIÓN'}
                ${order.phone ? `<br/><span style="font-size:0.75rem;">TEL: ${order.phone}</span>` : ''}
                ${additionalBadge}
              </div>
            `;
          }

          // Separación de platos y bebidas
          // Las bebidas van estrictamente al final de la tarjeta
          const drinksList = [];
          const platesHtmlList = [];

          if (order.plates && order.plates.length > 0) {
            order.plates.forEach((plate) => {
              const guisados = [];
              plate.items.forEach((it) => {
                if (it.kind === 'bebida') {
                  drinksList.push(it);
                } else {
                  guisados.push(it);
                }
              });

              if (guisados.length > 0) {
                const guisadosRows = guisados
                  .map((it) => `
                    <li class="kds-item-row">
                      <span class="kds-item-qty">${it.quantity}</span>
                      <span style="flex:1;">${it.name}</span>
                    </li>
                  `)
                  .join('');

                platesHtmlList.push(`
                  <div class="kds-plate-section">
                    <div class="kds-plate-title">
                      <span>${plate.name.toUpperCase()}</span>
                      ${plate.notes ? `<span class="kds-plate-note">[${plate.notes}]</span>` : ''}
                    </div>
                    <ul class="kds-items-list">${guisadosRows}</ul>
                  </div>
                `);
              }
            });
          } else {
            // Sin platos definidos
            const guisados = [];
            (order.items || []).forEach((it) => {
              if (it.kind === 'bebida') {
                drinksList.push(it);
              } else {
                guisados.push(it);
              }
            });

            if (guisados.length > 0) {
              const guisadosRows = guisados
                .map((it) => `
                  <li class="kds-item-row">
                    <span class="kds-item-qty">${it.quantity}</span>
                    <span style="flex:1;">${it.name}</span>
                  </li>
                `)
                .join('');

              platesHtmlList.push(`
                <div class="kds-plate-section">
                  <div class="kds-plate-title"><span>PLATILLOS</span></div>
                  <ul class="kds-items-list">${guisadosRows}</ul>
                </div>
              `);
            }
          }

          // Bloque de Bebidas (Al final de la tarjeta)
          let drinksHtml = '';
          if (drinksList.length > 0) {
            const drinksRows = drinksList
              .map((it) => `
                <li class="kds-item-row drink">
                  <span class="kds-item-qty drink">${it.quantity}</span>
                  <span style="flex:1;">${it.name}</span>
                </li>
              `)
              .join('');

            drinksHtml = `
              <div class="kds-drinks-section">
                <div class="kds-drinks-title">BEBIDAS</div>
                <ul class="kds-items-list">${drinksRows}</ul>
              </div>
            `;
          }

          const notesBlock = order.notes
            ? `<div class="kds-card-notes">NOTA: ${order.notes}</div>`
            : '';

          return `
            <article class="kds-card ${elapsed.isUrgent ? 'status-urgente' : ''}" data-order-id="${order.id}">
              <header class="kds-card-header">
                <div>
                  <div class="kds-card-folio">#${order.folio}</div>
                  ${destinationHtml}
                </div>
                <div class="kds-card-timer ${elapsed.colorClass}">
                  ${elapsed.label}
                </div>
              </header>

              <div class="kds-card-body">
                ${platesHtmlList.join('')}
                ${drinksHtml}
                ${notesBlock}
              </div>

              <footer class="kds-card-footer">
                <button class="kds-finish-btn" data-finish-id="${order.id}">
                  ORDEN TERMINADA ✓
                </button>
              </footer>
            </article>
          `;
        })
        .join('');

      // Restaurar las posiciones de scroll que tenían las tarjetas antes del render
      stageEl.querySelectorAll('.kds-card').forEach((card) => {
        const id = card.dataset.orderId;
        const body = card.querySelector('.kds-card-body');
        if (id && body && scrollPositions.has(id)) {
          body.scrollTop = scrollPositions.get(id);
        }
      });

      // En cocina solo pueden marcar como terminada la orden
      stageEl.querySelectorAll('.kds-finish-btn').forEach((btn) => {
        btn.addEventListener('click', () => updateStatus(btn.dataset.finishId, 'terminado'));
      });
    };

    const updateStatus = async (id, status) => {
      try {
        await fetch(`/api/orders/${id}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status }),
        });
        await loadQueue();
      } catch (err) {
        console.error(err);
      }
    };

    const loadQueue = async () => {
      try {
        const res = await fetch('/api/orders');
        const orders = await res.json();
        const activeQueue = orders.filter((o) => ['pendiente', 'en_preparacion'].includes(o.status));

        let hasNewOrder = false;
        activeQueue.forEach((order) => {
          if (!state.knownFolios.has(order.folio)) {
            state.knownFolios.add(order.folio);
            hasNewOrder = true;
          }
        });

        if (hasNewOrder && state.knownFolios.size > activeQueue.length) {
          playOrderDing();
        }

        updateComalSummary(activeQueue);
        renderKdsQueue(activeQueue);
      } catch (err) {
        console.error(err);
      }
    };

    // WALKIE TALKIE EN COCINA (CON AUDIO EN SEGUNDO PLANO Y PANTALLA BLOQUEADA)
    let mediaRecorder = null;
    let audioChunks = [];
    let wtTimerInterval = null;
    let wtStartTime = 0;

    const setupWalkieTalkie = () => {
      const wtBtn = document.getElementById('wtButton');
      const wtLabel = document.getElementById('wtLabel');
      const wtTimer = document.getElementById('wtTimer');
      const banner = document.getElementById('incomingAudioBanner');
      const replayBtn = document.getElementById('replayAudioBtn');
      const dismissBtn = document.getElementById('dismissAudioBtn');

      if (!wtBtn) return;

      // ============================================================
      // ARQUITECTURA DE AUDIO EN SEGUNDO PLANO Y PANTALLA APAGADA
      // ============================================================
      const createSilentCarrierUri = () => {
        try {
          const sampleRate = 8000;
          const numSamples = sampleRate * 2;
          const buffer = new ArrayBuffer(44 + numSamples * 2);
          const view = new DataView(buffer);
          view.setUint32(0, 0x52494646, false); // RIFF
          view.setUint32(4, 36 + numSamples * 2, true);
          view.setUint32(8, 0x57415645, false); // WAVE
          view.setUint32(12, 0x666d7420, false); // fmt
          view.setUint32(16, 16, true);
          view.setUint16(20, 1, true); // PCM
          view.setUint16(22, 1, true); // Mono
          view.setUint32(24, sampleRate, true);
          view.setUint32(28, sampleRate * 2, true);
          view.setUint16(32, 2, true);
          view.setUint16(34, 16, true);
          view.setUint32(36, 0x64617461, false); // data
          view.setUint32(40, numSamples * 2, true);
          for (let i = 0; i < numSamples; i++) {
            view.setInt16(44 + i * 2, (i % 2 === 0) ? 2 : -2, true);
          }
          const blob = new Blob([buffer], { type: 'audio/wav' });
          return URL.createObjectURL(blob);
        } catch (_) {
          return 'data:audio/wav;base64,UklGRigAAABXQVZFZm10IBAAAAABAAEARKwAAIhYAQACABAAZGF0YQQAAAAAAA==';
        }
      };

      const carrierUri = createSilentCarrierUri();
      let persistentAudio = null;
      let isCarrierActive = false;
      const voiceQueue = [];
      let isPlayingVoice = false;

      const getPersistentAudio = () => {
        if (!persistentAudio) {
          persistentAudio = new Audio();
          persistentAudio.playsInline = true;
          persistentAudio.setAttribute('playsinline', '');
          persistentAudio.setAttribute('webkit-playsinline', '');
        }
        return persistentAudio;
      };

      const resumeCarrier = () => {
        if (isPlayingVoice) return;
        const audio = getPersistentAudio();
        try {
          audio.pause();
          audio.onended = null;
          audio.onerror = null;
          audio.src = carrierUri;
          audio.loop = true;
          audio.volume = 0.02;
          audio.play().catch(() => {});
          isCarrierActive = true;

          if ('mediaSession' in navigator) {
            navigator.mediaSession.metadata = new MediaMetadata({
              title: 'Walkie-Talkie Cocina Activo',
              artist: 'Cocina & Meseros',
              album: 'Canal en Tiempo Real',
            });
            navigator.mediaSession.playbackState = 'playing';
          }
        } catch (_) {}
      };

      const playNextVoiceInQueue = () => {
        if (voiceQueue.length === 0) {
          isPlayingVoice = false;
          resumeCarrier();
          return;
        }

        isPlayingVoice = true;
        const item = voiceQueue.shift();
        const audio = getPersistentAudio();

        if (banner) {
          banner.style.display = 'flex';
          const bannerText = document.getElementById('incomingAudioText');
          if (bannerText) bannerText.textContent = `MENSAJE DE VOZ DE ${item.sender.toUpperCase()}`;
        }

        if (typeof Notification !== 'undefined' && Notification.permission === 'granted') {
          try {
            new Notification(`Walkie-Talkie · ${item.sender.toUpperCase()}`, {
              body: 'Nuevo mensaje de voz recibido de Mesero',
              tag: 'walkie-voice',
            });
          } catch (_) {}
        }

        if ('mediaSession' in navigator) {
          navigator.mediaSession.metadata = new MediaMetadata({
            title: `Mensaje de ${item.sender.toUpperCase()}`,
            artist: 'Las Gordibuenas Walkie',
            album: 'Canal de Cocina',
          });
          navigator.mediaSession.playbackState = 'playing';
        }

        try {
          audio.pause();
          audio.loop = false;
          audio.src = item.audioData;
          audio.volume = 1.0;
          audio.onended = () => {
            playNextVoiceInQueue();
          };
          audio.onerror = () => {
            playNextVoiceInQueue();
          };
          const p = audio.play();
          if (p) {
            p.catch((err) => {
              console.warn('Playback error:', err);
              playNextVoiceInQueue();
            });
          }
        } catch (e) {
          playNextVoiceInQueue();
        }
      };

      const queueVoiceMessage = (audioData, sender) => {
        voiceQueue.push({ audioData, sender });
        if (!isPlayingVoice) {
          playNextVoiceInQueue();
        }
      };

      const initBackgroundAudio = () => {
        if (isCarrierActive) return;
        getPersistentAudio();
        resumeCarrier();

        if (typeof Notification !== 'undefined' && Notification.permission === 'default') {
          Notification.requestPermission().catch(() => {});
        }

        if ('wakeLock' in navigator && document.visibilityState === 'visible') {
          navigator.wakeLock.request('screen').catch(() => {});
        }

        if ('mediaSession' in navigator) {
          navigator.mediaSession.setActionHandler('play', () => resumeCarrier());
          navigator.mediaSession.setActionHandler('pause', () => {});
        }
      };

      document.addEventListener('pointerdown', initBackgroundAudio, { once: true });
      document.addEventListener('touchstart', initBackgroundAudio, { once: true });

      // GRABACIÓN DE AUDIO (COMPATIBLE CON DISPOSITIVOS MÓVILES)
      let selectedMime = '';
      if (typeof MediaRecorder !== 'undefined' && MediaRecorder.isTypeSupported) {
        if (MediaRecorder.isTypeSupported('audio/mp4')) {
          selectedMime = 'audio/mp4';
        } else if (MediaRecorder.isTypeSupported('audio/webm;codecs=opus')) {
          selectedMime = 'audio/webm;codecs=opus';
        } else if (MediaRecorder.isTypeSupported('audio/webm')) {
          selectedMime = 'audio/webm';
        }
      }

      const startRecording = async () => {
        if (state.isRecordingWT) return;
        initBackgroundAudio();
        try {
          const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
          audioChunks = [];
          mediaRecorder = selectedMime
            ? new MediaRecorder(stream, { mimeType: selectedMime })
            : new MediaRecorder(stream);

          mediaRecorder.ondataavailable = (e) => {
            if (e.data.size > 0) audioChunks.push(e.data);
          };

          mediaRecorder.onstop = async () => {
            stream.getTracks().forEach((t) => t.stop());
            clearInterval(wtTimerInterval);
            if (wtTimer) wtTimer.style.display = 'none';

            if (audioChunks.length === 0) {
              resumeCarrier();
              return;
            }
            const mimeType = mediaRecorder.mimeType || selectedMime || 'audio/webm';
            const audioBlob = new Blob(audioChunks, { type: mimeType });
            if (audioBlob.size < 500) {
              resumeCarrier();
              return;
            }

            const reader = new FileReader();
            reader.readAsDataURL(audioBlob);
            reader.onloadend = async () => {
              const base64Data = reader.result;
              try {
                await fetch('/api/audio', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({
                    sender: 'Cocina',
                    audioData: base64Data,
                    duration: Math.round((Date.now() - wtStartTime) / 1000),
                  }),
                });
              } catch (err) {
                console.error(err);
              } finally {
                resumeCarrier();
              }
            };
          };

          if (persistentAudio && !isPlayingVoice) {
            persistentAudio.pause();
          }

          mediaRecorder.start();
          state.isRecordingWT = true;
          wtStartTime = Date.now();
          wtBtn.classList.add('recording');
          if (wtLabel) wtLabel.textContent = 'TRANSMITIENDO';
          if (wtTimer) {
            wtTimer.style.display = 'inline';
            wtTimer.textContent = '0:01';
            wtTimerInterval = setInterval(() => {
              const secs = Math.floor((Date.now() - wtStartTime) / 1000);
              wtTimer.textContent = `0:${secs < 10 ? '0' : ''}${secs}`;
            }, 500);
          }
        } catch (err) {
          alert('AUTORIZA EL MICROFONO.');
        }
      };

      const stopRecording = () => {
        if (!state.isRecordingWT) return;
        state.isRecordingWT = false;
        wtBtn.classList.remove('recording');
        if (wtLabel) wtLabel.textContent = 'WALKIE A MESEROS';
        if (mediaRecorder && mediaRecorder.state !== 'inactive') mediaRecorder.stop();
      };

      // PUSH-TO-TALK
      wtBtn.addEventListener('pointerdown', (e) => {
        e.preventDefault();
        try { wtBtn.setPointerCapture(e.pointerId); } catch (_) {}
        startRecording();
      });

      const handlePointerRelease = () => {
        if (state.isRecordingWT) {
          stopRecording();
        }
      };

      wtBtn.addEventListener('pointerup', handlePointerRelease);
      wtBtn.addEventListener('pointercancel', handlePointerRelease);
      wtBtn.addEventListener('contextmenu', (e) => e.preventDefault());

      // SETUP DE SSE PARA RECEPCIÓN EN SEGUNDO PLANO
      let audioEventSource = null;
      const connectAudioSSE = () => {
        try {
          if (audioEventSource) audioEventSource.close();
          const sinceParam = state.lastAudioTimestamp ? `?since=${state.lastAudioTimestamp}` : '';
          audioEventSource = new EventSource(`/api/audio/stream${sinceParam}`);

          audioEventSource.onmessage = (e) => {
            try {
              const msg = JSON.parse(e.data);
              if (msg && msg.sender === 'Mesero' && msg.id) {
                if (state.playedAudioIds.has(msg.id)) return;
                state.playedAudioIds.add(msg.id);
                state.lastAudioTimestamp = msg.timestamp || Date.now();
                state.lastPlayedAudioData = msg.audioData;

                queueVoiceMessage(msg.audioData, msg.sender);
              }
            } catch (_) {}
          };

          audioEventSource.onerror = () => {
            if (audioEventSource) audioEventSource.close();
            setTimeout(connectAudioSSE, 2500);
          };
        } catch (_) {}
      };
      connectAudioSSE();

      replayBtn?.addEventListener('click', () => {
        if (state.lastPlayedAudioData) {
          queueVoiceMessage(state.lastPlayedAudioData, 'Mesero');
        }
      });

      dismissBtn?.addEventListener('click', () => {
        if (banner) banner.style.display = 'none';
      });
    };

    // SETUP DE EVENTOS EN TIEMPO REAL PARA PEDIDOS (SSE SIN POLLING)
    let ordersEventSource = null;
    const connectOrdersSSE = () => {
      try {
        if (ordersEventSource) ordersEventSource.close();
        ordersEventSource = new EventSource('/api/orders/stream');
        ordersEventSource.onmessage = (e) => {
          try {
            const event = JSON.parse(e.data);
            if (event && ['order:created', 'order:updated', 'order:deleted', 'account:closed'].includes(event.type)) {
              loadQueue();
            }
          } catch (_) {}
        };
        ordersEventSource.onerror = () => {
          if (ordersEventSource) ordersEventSource.close();
          setTimeout(connectOrdersSSE, 3000);
        };
      } catch (_) {}
    };

    // Reconexión y reactivación al volver a estar visible la pestaña
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') {
        if ('wakeLock' in navigator) {
          navigator.wakeLock.request('screen').catch(() => {});
        }
        loadQueue();
      }
    });

    const setupControls = () => {
      const soundBtn = document.getElementById('soundToggleBtn');
      soundBtn?.addEventListener('click', () => {
        state.soundEnabled = !state.soundEnabled;
        soundBtn.textContent = state.soundEnabled ? 'SONIDO ON' : 'SONIDO OFF';
      });

      const fsBtn = document.getElementById('fullscreenBtn');
      fsBtn?.addEventListener('click', () => {
        if (!document.fullscreenElement) {
          document.documentElement.requestFullscreen().catch(() => {});
          fsBtn.textContent = 'SALIR';
        } else {
          document.exitFullscreen().catch(() => {});
          fsBtn.textContent = 'PANTALLA COMPLETA';
        }
      });
    };

    setupWalkieTalkie();
    setupControls();
    loadQueue();
    connectOrdersSSE();
  </script>
</BaseLayout>
